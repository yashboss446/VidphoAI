generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  projects      Project[]
}

model Project {
  id         String       @id @default(cuid())
  name       String
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  mediaAssets MediaAsset[]
  editPlans  EditPlanRecord[]
  renderJobs RenderJob[]
  chatMessages ChatMessage[]
}

enum MediaKind {
  video
  image
  audio
}

model MediaAsset {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  kind          MediaKind
  s3Key         String
  originalName  String
  durationSec   Float?
  width         Int?
  height        Int?
  fps           Float?
  thumbnailKey  String?
  createdAt     DateTime  @default(now())
}

model EditPlanRecord {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  version    Int
  dataJson   Json
  createdAt  DateTime @default(now())

  @@unique([projectId, version])
}

enum RenderStatus {
  queued
  processing
  completed
  failed
}

model RenderJob {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  editPlanId   String
  status       RenderStatus @default(queued)
  progress     Float        @default(0)
  outputKey    String?
  error        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Scaffolded now, wired up in Phase 2 (chat-driven AI editing).
model ChatMessage {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  role       String
  content    String
  createdAt  DateTime @default(now())
}
