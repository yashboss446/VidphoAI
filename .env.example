# Postgres (via Prisma)
DATABASE_URL="postgresql://editor:editor@localhost:5432/editor?schema=public"

# Redis (BullMQ) — mapped to 6380 to avoid clashing with any other local Redis on 6379
REDIS_URL="redis://localhost:6380"

# S3-compatible storage (LocalStack locally — any non-empty key/secret works)
S3_ENDPOINT="http://localhost:4566"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
S3_BUCKET="editor-media"
S3_FORCE_PATH_STYLE="true"
# Public base URL the browser uses to reach storage (differs from S3_ENDPOINT if proxied)
S3_PUBLIC_URL="http://localhost:4566/editor-media"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Anthropic (Phase 2 — chat-driven AI editing)
ANTHROPIC_API_KEY=""
